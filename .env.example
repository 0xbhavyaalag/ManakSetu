# ==========================================
# ANNADHARA AI - Configuration Environment
# ==========================================

# Backend Database (Default SQLite for local zero-config execution)
DATABASE_URL=sqlite:///./annadhara.db

# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://annadhara:annadhara_secure_password@localhost:5432/annadhara_db

# JWT & Security
SECRET_KEY=annadhara-secret-key-sih2026-secure-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Queue Engine & Thresholds
CROWD_QUEUE_THRESHOLD=80
DEFAULT_AVG_PROCESSING_MINS=6
DEFAULT_ACTIVE_COUNTERS=3
